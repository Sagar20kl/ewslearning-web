datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String
  role         String       @default("STUDENT") // "SUPER_ADMIN" | "ADMIN" | "CORPORATE_CLIENT" | "STUDENT"
  organization String?
  department   String?
  avatar       String?
  phone        String?
  isVerified   Boolean      @default(true)
  lastLoginAt  DateTime?
  enrollments  Enrollment[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Program {
  id               String       @id @default(uuid())
  slug             String       @unique
  title            String
  tagline          String
  description      String
  sector           String       @default("Corporate") // "Corporate" | "Industrial" | "Municipal" | "Universal"
  mode             String       @default("Hybrid")    // "Online" | "Offline" | "Hybrid"
  duration         String
  level            String       @default("Intermediate")
  rating           Float        @default(4.9)
  reviewCount      Int          @default(0)
  enrolledCount    Int          @default(0)
  priceINR         Int          @default(4999)
  priceUSD         Int          @default(69)
  coverImage       String
  instructorName   String
  instructorRole   String
  highlights       String       @default("[]") // JSON string array
  learningOutcomes String       @default("[]") // JSON string array
  targetAudience   String       @default("[]") // JSON string array
  prerequisites    String       @default("[]") // JSON string array
  modules          Module[]
  enrollments      Enrollment[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Module {
  id        String   @id @default(uuid())
  title     String
  duration  String
  order     Int      @default(0)
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
}

model Lesson {
  id            String           @id @default(uuid())
  title         String
  duration      String
  videoUrl      String
  isFreePreview Boolean          @default(false)
  summary       String
  order         Int              @default(0)
  moduleId      String
  module        Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress      LessonProgress[]
}

model LessonProgress {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String
  isCompleted Boolean  @default(false)
  watchSeconds Int     @default(0)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt

  @@unique([userId, lessonId])
}

model Enrollment {
  id           String        @id @default(uuid())
  userId       String
  programId    String
  progress     Float         @default(0)
  status       String        @default("ENROLLED") // "ENROLLED" | "IN_PROGRESS" | "COMPLETED"
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  program      Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  certificate  Certificate?
  examAttempts ExamAttempt[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, programId])
}

model ExamAttempt {
  id             String     @id @default(uuid())
  enrollmentId   String
  userId         String
  score          Int
  totalQuestions Int        @default(5)
  passed         Boolean    @default(false)
  answersJson    String?
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  attemptedAt    DateTime   @default(now())
}

model Certificate {
  id            String     @id @default(uuid())
  certificateId String     @unique
  studentName   String
  courseTitle   String
  distinction   String     @default("Verified Masterclass Distinction")
  verifyUrl     String
  enrollmentId  String     @unique
  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  issuedAt      DateTime   @default(now())
}

model BlogPost {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  excerpt         String
  category        String
  readTime        String
  publishedAt     String
  isAutoGenerated Boolean  @default(false)
  coverImage      String
  authorName      String
  authorRole      String
  authorAvatar    String
  sourceCitations String   @default("[]") // JSON string array
  content         String
  createdAt       DateTime @default(now())
}

model Inquiry {
  id              String   @id @default(uuid())
  name            String
  email           String
  phone           String?
  organization    String
  programInterest String
  teamSize        String
  mode            String
  message         String?
  status          String   @default("NEW") // "NEW" | "CONTACTED" | "PROPOSAL_SENT" | "ENROLLED"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SupportTicket {
  id           String   @id @default(uuid())
  ticketNumber String   @unique
  name         String
  email        String
  message      String
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())
}

model CallbackRequest {
  id        String   @id @default(uuid())
  name      String
  phone     String
  topic     String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model CorporateMember {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  department   String
  role         String
  coursesCompleted Int  @default(0)
  totalHours   Float    @default(0)
  brsrStatus   String   @default("COMPLIANT")
  organization String   @default("EcoIndustries Corp")
  joinedAt     DateTime @default(now())
}
